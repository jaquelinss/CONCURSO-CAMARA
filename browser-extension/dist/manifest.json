{
  "manifest_version": 3,
  "name": "Estudo Câmara Tracker",
  "version": "1.0.0",
  "description": "Ganha pontos no app respondendo questões no Gemini e sites suportados.",
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "js": [
        "assets/content.tsx-loader-Br9rmBb7.js"
      ],
      "matches": [
        "*://gemini.google.com/*"
      ],
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "notifications",
    "activeTab",
    "scripting"
  ],
  "web_accessible_resources": [
    {
      "matches": [
        "*://gemini.google.com/*"
      ],
      "resources": [
        "assets/rolldown-runtime-Czjbc987.js",
        "assets/jsx-runtime-CRr1Db8x.js",
        "assets/content.tsx-CVfzgdlH.js"
      ],
      "use_dynamic_url": false
    }
  ]
}
