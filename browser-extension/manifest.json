{
  "manifest_version": 3,
  "name": "Estudo Câmara Tracker",
  "version": "1.0.0",
  "description": "Ganha pontos no app respondendo questões no Gemini e sites suportados.",
  "action": {
    "default_popup": "index.html"
  },
  "content_scripts": [
    {
      "matches": ["*://gemini.google.com/*"],
      "js": ["src/content.tsx"],
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "permissions": [
    "storage",
    "contextMenus",
    "notifications",
    "activeTab",
    "scripting"
  ]
}
